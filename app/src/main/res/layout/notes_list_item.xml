<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/back"
        android:padding="@dimen/small_padding"
        android:background="?attr/selectableItemBackground"
        android:orientation="horizontal">
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/layout_small_margin"
            android:layout_marginBottom="@dimen/layout_very_small_margin"
            android:layout_marginStart="@dimen/layout_small_margin"
            android:layout_marginEnd="@dimen/layout_small_margin"
            android:padding="0dp"
            app:cardElevation="0dp"
            android:clipToPadding="true"
            app:cardCornerRadius="6dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/plan_item_type2"
                app:tint="@color/colorAccent"
                android:scaleType="centerCrop"
                android:id="@+id/icon"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/layout_small_margin"
            android:layout_marginBottom="@dimen/layout_very_small_margin"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_medium"
                android:textStyle="bold"
                android:textColor="@color/textColorLight"
                android:text="This is a sample title"
                android:fontFamily="@font/defaultfont"
                android:id="@+id/title"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_small"
                android:textColor="@color/grey_20"
                android:text="This is a sample title"
                android:layout_marginTop="@dimen/layout_very_small_margin"
                android:fontFamily="@font/defaultfont"
                android:id="@+id/date"/>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ms_ic_chevron_right"
            android:layout_marginStart="@dimen/layout_very_small_margin"
            android:layout_marginEnd="@dimen/layout_very_small_margin"
            app:tint="@color/grey_20"/>


    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/grey_20"/>

</LinearLayout>