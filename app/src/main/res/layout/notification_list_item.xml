<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/main"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/notification_item"
            android:orientation="vertical"
            android:layout_margin="@dimen/layout_very_small_margin"
            android:padding="@dimen/small_padding"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:fontFamily="@font/defaultfont"
                android:layout_height="wrap_content"
                android:text="Notification Title"
                android:textColor="@color/textColorLight"
                android:textSize="@dimen/text_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/layout_very_small_margin"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">


                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_small"
                        android:textColor="@color/grey_20"
                        android:autoLink="all"
                        android:id="@+id/text"
                        android:text="Notification Title"/>
                </LinearLayout>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                android:id="@+id/imageCard"
                android:layout_gravity="center"
                app:cardElevation="3dp"
                android:visibility="gone"
                android:layout_margin="@dimen/layout_very_small_margin"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/url"
                    android:adjustViewBounds="true"
                    android:maxHeight="170dp"
                    />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/layout_small_margin"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_tiny"
                    android:textColor="@color/grey_700"
                    android:id="@+id/time"
                    android:visibility="gone"
                    android:layout_marginEnd="@dimen/layout_small_margin"
                    android:fontFamily="@font/defaultfont"
                    android:text="23:99"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_tiny"
                    android:textColor="@color/grey_20"
                    android:id="@+id/date"
                    android:layout_marginLeft="@dimen/layout_small_margin"
                    android:layout_marginEnd="@dimen/layout_small_margin"
                    android:fontFamily="@font/defaultfont"
                    android:text="Notification Title"/>

            </LinearLayout>


        </LinearLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="@dimen/layout_small_margin"
            android:layout_marginEnd="@dimen/layout_small_margin"
            android:layout_gravity="top"
            android:visibility="visible"
            android:scaleType="centerCrop"
            android:src="@drawable/notification"
            android:id="@+id/img"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_margin="@dimen/layout_very_small_margin"
        android:background="@color/grey_20"/>

</LinearLayout>